{
  "name": "plenum-mobile",
  "version": "0.5.0",
  "private": true,
  "description": "The Plenum phone shell and the Capacitor projects for Android and iPhone. scripts/build-mobile.mjs builds mobile/www and relay/public from here.",
  "type": "module",
  "license": "SEE LICENSE IN ../LICENSE.txt",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../scripts/build-mobile.mjs",
    "build:dev": "node ../scripts/build-mobile.mjs --dev",
    "check":"node ../scripts/build-mobile.mjs --check",
    "sync": "cap sync",
    "test": "node --test \"test/*.test.mjs\"",
    "selftest": "node ../scripts/build-mobile.mjs --check"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/browser": "^8",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "^8",
    "@capacitor/haptics": "^8",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/network": "^8",
    "@capacitor/share": "^8",
    "@capacitor/text-zoom": "8.0.1",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "jsqr": "1.4.0",
    "plenum-dictation": "file:plugins/dictation",
    "plenum-isolated-preview": "file:plugins/isolated-preview",
    "plenum-unifiedpush": "file:plugins/unifiedpush"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
