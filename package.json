{
  "name": "muse-console",
  "productName": "Plenum",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Desktop console that runs Claude Code, Codex, Gemini CLI and Muse Code side by side with API models",
  "author": {
    "name": "RealAlcibiades",
    "url": "https://github.com/RealAlcibiades"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node plenum.mjs",
    "desktop": "electron .",
    "computer:smoke": "electron desktop/computer/smoke.cjs",
    "legal": "node scripts/build-legal.mjs",
    "mobile:build": "node scripts/build-mobile.mjs",
    "pack": "npm run legal && npm run mobile:build && electron-builder --win --x64 --dir --publish never",
    "dist": "npm run legal && npm run mobile:build && electron-builder --win --x64 --publish never",
    "dist:portable": "npm run legal && npm run mobile:build && electron-builder --win portable --x64 --publish never",
    "dist:mac": "npm run legal && npm run mobile:build && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:mac:x64": "npm run legal && npm run mobile:build && electron-builder --mac dmg zip --x64 --publish never",
    "dist:mac:arm64": "npm run legal && npm run mobile:build && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:linux": "npm run legal && npm run mobile:build && electron-builder --linux AppImage deb --x64 --publish never",
    "dist:all": "node -e \"const s={win32:'dist',darwin:'dist:mac',linux:'dist:linux'}[process.platform];if(s)require('child_process').execSync('npm run '+s,{stdio:'inherit'})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "electron-updater": "^6.8.9",
    "koffi": "^2.9.0",
    "pdfjs-dist": "6.4.299",
    "qrcode-generator": "2.0.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.museconsole.desktop",
    "productName": "Plenum",
    "copyright": "Copyright © 2026 RealAlcibiades. All rights reserved.",
    "publish": {
      "provider": "github",
      "owner": "RealAlcibiades",
      "repo": "Plenum",
      "releaseType": "draft"
    },
    "generateUpdatesFilesForAllChannels": true,
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "lib/**/*",
      "lib/overlay/**/*",
      "public/**/*",
      "server.mjs",
      "plenum.mjs",
      "LICENSE.txt",
      "THIRD-PARTY-NOTICES.txt",
      "legal/**/*",
      "mobile/www/**/*",
      "!mobile/www/ui/**",
      "package.json",
      "build/icon.png",
      "node_modules/**/*",
      "!**/*.map",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/build/**",
      "!node_modules/@napi-rs/**"
    ],
    "extraFiles": [
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "legal/EULA.txt",
        "to": "EULA.txt"
      }
    ],
    "asar": false,
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": false,
      "onlyLoadAppFromAsar": false,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "resetAdHocDarwinSignature": true
    },
    "win": {
      "icon": "build/icon.ico",
      "files": [
        "desktop/**/*",
        "lib/**/*",
        "lib/overlay/**/*",
        "public/**/*",
        "server.mjs",
        "plenum.mjs",
        "LICENSE.txt",
        "THIRD-PARTY-NOTICES.txt",
        "legal/**/*",
        "mobile/www/**/*",
        "!mobile/www/ui/**",
        "package.json",
        "build/icon.png",
        "node_modules/**/*",
        "!**/*.map",
        "!node_modules/pdfjs-dist/web/**",
        "!node_modules/pdfjs-dist/types/**",
        "!node_modules/pdfjs-dist/image_decoders/**",
        "!node_modules/pdfjs-dist/build/**",
        "!node_modules/@napi-rs/**",
        "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_arm64,win32_ia32}/**"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "license": "legal/EULA.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Plenum"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "files": [
        "desktop/**/*",
        "lib/**/*",
        "lib/overlay/**/*",
        "public/**/*",
        "server.mjs",
        "plenum.mjs",
        "LICENSE.txt",
        "THIRD-PARTY-NOTICES.txt",
        "legal/**/*",
        "mobile/www/**/*",
        "!mobile/www/ui/**",
        "package.json",
        "build/icon.png",
        "node_modules/**/*",
        "!**/*.map",
        "!node_modules/pdfjs-dist/web/**",
        "!node_modules/pdfjs-dist/types/**",
        "!node_modules/pdfjs-dist/image_decoders/**",
        "!node_modules/pdfjs-dist/build/**",
        "!node_modules/@napi-rs/**",
        "!node_modules/koffi/build/koffi/{freebsd_*,linux_*,musl_*,openbsd_*,win32_*}/**"
      ]
    },
    "dmg": {
      "license": "legal/EULA.txt"
    },
    "linux": {
      "category": "Development",
      "files": [
        "desktop/**/*",
        "lib/**/*",
        "lib/overlay/**/*",
        "public/**/*",
        "server.mjs",
        "plenum.mjs",
        "LICENSE.txt",
        "THIRD-PARTY-NOTICES.txt",
        "legal/**/*",
        "mobile/www/**/*",
        "!mobile/www/ui/**",
        "package.json",
        "build/icon.png",
        "node_modules/**/*",
        "!**/*.map",
        "!node_modules/pdfjs-dist/web/**",
        "!node_modules/pdfjs-dist/types/**",
        "!node_modules/pdfjs-dist/image_decoders/**",
        "!node_modules/pdfjs-dist/build/**",
        "!node_modules/@napi-rs/**",
        "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,musl_*,openbsd_*,win32_*,linux_arm*,linux_ia32,linux_loong64,linux_riscv64d}/**"
      ]
    },
    "appImage": {
      "license": "legal/EULA.txt"
    },
    "deb": {
      "maintainer": "[LICENSOR NAME] <[CONTACT EMAIL]>"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RealAlcibiades/Plenum.git"
  }
}
